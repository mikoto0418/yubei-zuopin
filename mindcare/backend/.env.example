# 复本为 .env 并填入真实值（.env 已被 git 忽略）
# JWT 签名密钥（生产环境务必随机长字符串）
SECRET_KEY=please-change-me-to-a-random-secret

# ---- AI 对话配置（Agnes AI，OpenAI 兼容）----
# 配置 LLM_API_KEY 后走 /chat/completions。默认仅云端：云端失败直接报错（不降级本地）。
# 需要离线兜底时额外设置 ENABLE_LOCAL_FALLBACK=1。
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash
# ENABLE_LOCAL_FALLBACK=1   # 可选：置 1 时云端失败回落本地话术（默认关闭）

# ----------------- Flask -----------------
PORT=4101