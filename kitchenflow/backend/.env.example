# KitchenFlow 环境变量示例（复制为 .env 后按需修改）

# 服务端口（默认 4201）
PORT=4201

# JWT 密钥：不配置会生成进程级随机密钥，重启后登录态失效
JWT_SECRET=kitchenflow-dev-secret
TOKEN_TTL=7d

# 数据库文件路径（默认 backend/data/kitchenflow.db）
# DB_PATH=./data/kitchenflow.db

# AI：不配置 LLM_API_KEY 时三个 AI 接口自动降级为本地规则，响应 source=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20000
