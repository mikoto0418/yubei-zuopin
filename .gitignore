# ============================================
# 预备作品工作区 · 统一忽略规则
# ============================================

# ---- 依赖 ----
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ---- 构建产物 ----
dist/
dist*/
build/

# ---- 环境变量（含真实密钥，切勿提交）----
.env
*.env
!.env.example
!**/.env.example

# ---- 数据库（本地生成）----
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3

# ---- 日志 ----
*.log
*.pid
npm-debug.log*

# ---- 测试缓存 ----
.pytest_cache/
.coverage
htmlcov/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 归档与交付产物（体积大，单独管理）----
_dist/
_archive/
_backup_frontends_*/
