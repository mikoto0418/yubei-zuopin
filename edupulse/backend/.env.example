# =============================================
# EduPulse 环境变量示例（复制为 .env 并按需修改）
# 注意：密码/JWT 密钥/LLM_KEY 请勿提交到 git
# =============================================

# 后端端口与服务密钥（端口默认 4103，可用 PORT 覆盖）
PORT=4103
SECRET_KEY=edupulse-dev-secret-please-change-to-a-long-random-string-0001
JWT_SECRET_KEY=edupulse-jwt-secret-please-change-this-32plus-bytes-key

# 数据库（默认 sqlite:///backend/edupulse.db）
# DATABASE_URL=sqlite:///F:/traecode/edupulse/backend/edupulse.db

# ---- AI 配置（可选，Agnes AI；不配则使用本地 mock 答案）----
# 兼容 OpenAI 的 base_url，Agnes AI: https://apihub.agnes-ai.com/v1
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# 其它可选: OpenAI https://api.openai.com/v1 / DeepSeek https://api.deepseek.com/v1

# 你的大模型 API Key（填了才走智能大模型）
LLM_API_KEY=

# 使用的模型名（推荐：agnes-2.5-flash）
LLM_MODEL=agnes-2.5-flash