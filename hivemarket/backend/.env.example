# HiveMarket 后端环境变量
# 复制此文件为 .env 并填入真实值

# 服务端口
PORT=4104

# JWT 签名密钥（务必替换为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-secret

# 数据库文件路径（相对 backend 目录）
DB_PATH=./data/hivemarket.db

# ---- AI 配置（可选，Agnes AI）----
# 配置了 LLM_API_KEY + LLM_BASE_URL 就会调用兼容 OpenAI 的接口生成商品描述；
# 未配置时后端自动降级为本地模板 Mock，前端功能仍可用。
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash