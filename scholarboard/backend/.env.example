# 服务端口
PORT=4102

# JWT 签名密钥（生产环境务必改为随机长字符串；也可用 SECRET_KEY 作为别名）
JWT_SECRET=please-change-me-to-a-long-random-string

# SQLite 数据库文件路径（相对 backend/）
DB_PATH=./data/scholarboard.db

# ---- AI 润色接口配置（可选，Agnes AI）----
# 若配置了 LLM_API_KEY，后端会调用兼容 OpenAI 的 /chat/completions 接口进行真实润色；
# 若未配置，则自动降级返回本地保底润色结果（source: local）。
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=
LLM_MODEL=agnes-2.5-flash